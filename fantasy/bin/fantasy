#!/usr/bin/env bash
# Fantasy launcher.
#   fantasy           start the server in the background (if needed) and open the site
#   fantasy stop      stop the server
#   fantasy restart   restart the server (picks up code changes)
#   fantasy status    show whether it is running
#   fantasy logs      follow the server log
#   fantasy fg        run in the foreground (Ctrl+C to stop)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/fantasy"
LOG="$STATE/server.log"
PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("port", 8420))' "$DIR/config.json")"
URL="http://localhost:$PORT"
mkdir -p "$STATE"

healthy() { curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1; }

start() {
  if healthy; then return 0; fi
  echo "Starting Fantasy on $URL"
  (cd "$DIR" && setsid nohup python3 "$DIR/server.py" >>"$LOG" 2>&1 &)
  for _ in $(seq 1 50); do
    healthy && return 0
    sleep 0.2
  done
  echo "The server did not start. Last lines of $LOG:" >&2
  tail -n 20 "$LOG" >&2
  exit 1
}

stop() {
  if pkill -u "$USER" -f "python3 $DIR/server.py" 2>/dev/null; then
    for _ in $(seq 1 25); do
      healthy || break
      sleep 0.2
    done
    echo "Stopped Fantasy"
  else
    echo "Fantasy is not running"
  fi
}

open_site() {
  if command -v xdg-open >/dev/null; then
    xdg-open "$URL" >/dev/null 2>&1 &
  fi
  echo "Open $URL"
}

case "${1:-open}" in
  open | "") start; open_site ;;
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.5; start; echo "Restarted" ;;
  status) healthy && echo "Running on $URL" || echo "Not running" ;;
  logs) tail -n 50 -f "$LOG" ;;
  fg) cd "$DIR" && exec python3 "$DIR/server.py" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
