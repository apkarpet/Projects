[Unit]
Description=Fantasy round sync, Thursday and Saturday mornings

[Timer]
# Hourly so a machine that wakes mid-morning still syncs; repeat runs are cheap.
# Not Persistent: a missed morning must not run later in the day.
OnCalendar=Thu,Sat *-*-* 07..11:00:00
AccuracySec=1min

[Install]
WantedBy=timers.target
