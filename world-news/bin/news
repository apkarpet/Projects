#!/usr/bin/env bash
# World News launcher.
#   news           start the server in the background (if needed) and open the site
#   news stop      stop the server
#   news restart   restart the server (picks up code changes)
#   news status    show whether it is running
#   news logs      follow the server log
#   news fg        run in the foreground (Ctrl+C to stop)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/world-news"
PIDFILE="$STATE/server.pid"
LOG="$STATE/server.log"
PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("port", 8420))' "$DIR/config.json")"
URL="http://localhost:$PORT"
mkdir -p "$STATE"

healthy() { curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1; }

start() {
  if healthy; then return 0; fi
  echo "Starting World News on $URL"
  (cd "$DIR" && setsid nohup python3 "$DIR/server.py" >>"$LOG" 2>&1 & echo $! >"$PIDFILE")
  for _ in $(seq 1 50); do
    healthy && return 0
    sleep 0.2
  done
  echo "The server did not start. Last lines of $LOG:" >&2
  tail -n 20 "$LOG" >&2
  exit 1
}

stop() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" && echo "Stopped World News"
  else
    pkill -u "$USER" -f "python3 $DIR/server.py" 2>/dev/null && echo "Stopped World News" || echo "World News is not running"
  fi
  rm -f "$PIDFILE"
}

open_site() {
  if command -v xdg-open >/dev/null; then
    xdg-open "$URL" >/dev/null 2>&1 &
  fi
  echo "Open $URL"
}

case "${1:-open}" in
  open | "") start; open_site ;;
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.5; start; echo "Restarted" ;;
  status) healthy && echo "Running on $URL" || echo "Not running" ;;
  logs) tail -n 50 -f "$LOG" ;;
  fg) cd "$DIR" && exec python3 "$DIR/server.py" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
